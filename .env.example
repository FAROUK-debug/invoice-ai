# Which vision LLM reads the invoices: gemini (default, free tier) or groq
LLM_PROVIDER=gemini

# https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# https://console.groq.com/keys (only if LLM_PROVIDER=groq)
GROQ_API_KEY=
GROQ_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

MAX_FILE_SIZE_MB=10
